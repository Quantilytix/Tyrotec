PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URLs, no trailing slash. BACKEND_URL builds PayFast's notify_url;
# FRONTEND_URL is where password-reset emails send people.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Leave blank locally
# to allow any origin; in production set it to the frontend URL.
CORS_ORIGINS=

# Outgoing notification emails. Set BREVO_API_KEY to send through Brevo's
# HTTPS API (required on hosts that block SMTP ports, like Render's Free plan);
# otherwise SMTP_HOST is used. Leave both blank to skip real email.
# EMAIL_FROM must be a sender verified in Brevo (or allowed by the SMTP server).
EMAIL_FROM=Tyrotec <sales@tyrotec.co.za>
BREVO_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PayFast. `sandbox` or `live`. PAYFAST_PASSPHRASE must match the passphrase on
# the PayFast merchant account exactly -- leave it blank if the account has none.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=http://localhost:5173/orders
PAYFAST_CANCEL_URL=http://localhost:5173/orders

# Meta WhatsApp Cloud API. Use a permanent System User access token in
# production -- temporary tokens from the Meta dashboard expire after 24 hours.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Product import from receipts/spreadsheets.
GEMINI_API_KEY=

# Orders above this total (ZAR) are flagged for admin review.
ADMIN_REVIEW_THRESHOLD=50000
# How long fast checkout holds stock, and how early customers are warned.
RESERVATION_EXPIRY_MINUTES=60
RESERVATION_WARNING_LEAD_MINUTES=10
# true = the API runs the reservation warning/release jobs itself every 5
# minutes (hosting without cron jobs, e.g. Render Free). Only with ONE API
# instance, and never together with separate cron jobs. Leave false locally
# unless you mean to act on real reservations in the configured database.
RUN_JOBS_IN_PROCESS=false
