PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP for outgoing notification emails. Leave SMTP_HOST blank to skip real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
